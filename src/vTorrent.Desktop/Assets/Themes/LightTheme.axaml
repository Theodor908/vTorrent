<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme - Warm Cream Tones -->
    <!-- Clean, warm aesthetic with good contrast -->

    <!-- Override Fluent Theme Resources for proper control styling -->
    <!-- ComboBox dropdown - remove border -->
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="Transparent"/>
    <Thickness x:Key="ComboBoxDropdownBorderThickness">0</Thickness>

    <!-- TextBox foreground colors for all states -->
    <SolidColorBrush x:Key="TextControlForeground" Color="#000000"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#000000"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#000000"/>
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#718096"/>

    <!-- NumericUpDown/ButtonSpinner arrow colors -->
    <SolidColorBrush x:Key="ButtonSpinnerButtonForeground" Color="#000000"/>
    <SolidColorBrush x:Key="ButtonSpinnerButtonForegroundPointerOver" Color="#000000"/>
    <SolidColorBrush x:Key="ButtonSpinnerButtonForegroundPressed" Color="#000000"/>
    <SolidColorBrush x:Key="ButtonSpinnerButtonForegroundDisabled" Color="#718096"/>

    <!-- RepeatButton foreground (spinner arrows) -->
    <SolidColorBrush x:Key="RepeatButtonForeground" Color="#000000"/>
    <SolidColorBrush x:Key="RepeatButtonForegroundPointerOver" Color="#000000"/>
    <SolidColorBrush x:Key="RepeatButtonForegroundPressed" Color="#000000"/>
    <SolidColorBrush x:Key="RepeatButtonForegroundDisabled" Color="#718096"/>

    <!-- Button background overrides for light theme -->
    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>

    <!-- Button foreground overrides for light theme -->
    <SolidColorBrush x:Key="ButtonForeground" Color="#000000"/>
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#000000"/>
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#000000"/>
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#718096"/>

    <!-- Button border overrides -->
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#d4d1ca"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#C4884A"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#C4884A"/>
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#a8a59e"/>

    <!-- ComboBox dropdown background -->
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#ffffff"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundPointerOver" Color="#ffffff"/>
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#ffffff"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#ffffff"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#ffffff"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#f5f2eb"/>
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#000000"/>
    <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#000000"/>
    <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#000000"/>
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#718096"/>

    <!-- Flyout/Popup backgrounds -->
    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#ffffff"/>
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#ffffff"/>
    <SolidColorBrush x:Key="ToolTipBackground" Color="#ffffff"/>

    <!-- Control content theme foregrounds (used by Fluent theme for button content) -->
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumHighBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SystemControlHighlightBaseHighBrush" Color="#C4884A"/>
    <SolidColorBrush x:Key="SystemControlHighlightBaseMediumHighBrush" Color="#C4884A"/>
    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#f5f2eb"/>
    <SolidColorBrush x:Key="SystemControlBackgroundBaseHighBrush" Color="#ffffff"/>

    <!-- Accent control backgrounds -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#C4884A"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#D4985A"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#B4783A"/>
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#ffffff"/>
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#ffffff"/>
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#ffffff"/>

    <!-- Background Colors - Warm cream tones -->
    <Color x:Key="PrimaryBackgroundColor">#fffcf5</Color>
    <Color x:Key="SecondaryBackgroundColor">#f5f2eb</Color>
    <Color x:Key="SidebarBackgroundColor">#ebe8e1</Color>
    <Color x:Key="CardBackgroundColor">#ffffff</Color>
    <Color x:Key="HoverBackgroundColor">#e5e2db</Color>
    <Color x:Key="TertiaryBackgroundColor">#dbd8d1</Color>

    <!-- Text Colors - Dark for good readability -->
    <Color x:Key="TextPrimaryColor">#000000</Color>
    <Color x:Key="TextSecondaryColor">#000000</Color>
    <Color x:Key="TextTertiaryColor">#718096</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderColorValue">#d4d1ca</Color>
    <Color x:Key="BorderHoverColor">#a8a59e</Color>

    <!-- Accent Colors -->
    <Color x:Key="AccentCyanColor">#4A90A4</Color>
    <Color x:Key="AccentBlueColor">#4299E1</Color>
    <Color x:Key="AccentGoldColor">#C4884A</Color>
    <Color x:Key="AccentGreenColor">#48BB78</Color>
    <Color x:Key="AccentRedColor">#F56565</Color>
    <Color x:Key="AccentOrangeColor">#ED8936</Color>
    <Color x:Key="AccentPurpleColor">#805AD5</Color>
    <Color x:Key="AccentSilverColor">#718096</Color>

    <!-- Toggle Colors -->
    <Color x:Key="ToggleOffColor">#a8a59e</Color>
    <Color x:Key="ToggleOnColor">#C4884A</Color>

    <!-- State Colors -->
    <Color x:Key="SuccessColor">#48BB78</Color>
    <Color x:Key="WarningColor">#ED8936</Color>
    <Color x:Key="ErrorColor">#F56565</Color>
    <Color x:Key="InfoColor">#4299E1</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBackground" Color="{StaticResource PrimaryBackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBackground" Color="{StaticResource SecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="HoverBackground" Color="{StaticResource HoverBackgroundColor}"/>
    <SolidColorBrush x:Key="TertiaryBackground" Color="{StaticResource TertiaryBackgroundColor}"/>

    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}"/>

    <SolidColorBrush x:Key="BorderColor" Color="{StaticResource BorderColorValue}"/>
    <SolidColorBrush x:Key="BorderHover" Color="{StaticResource BorderHoverColor}"/>

    <SolidColorBrush x:Key="AccentCyan" Color="{StaticResource AccentCyanColor}"/>
    <SolidColorBrush x:Key="AccentBlue" Color="{StaticResource AccentBlueColor}"/>
    <SolidColorBrush x:Key="AccentGold" Color="{StaticResource AccentGoldColor}"/>
    <SolidColorBrush x:Key="SelectionBorder" Color="{StaticResource AccentGoldColor}"/>
    <SolidColorBrush x:Key="AccentSilver" Color="{StaticResource AccentSilverColor}"/>
    <SolidColorBrush x:Key="AccentGreen" Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="AccentRed" Color="{StaticResource AccentRedColor}"/>
    <SolidColorBrush x:Key="AccentOrange" Color="{StaticResource AccentOrangeColor}"/>
    <SolidColorBrush x:Key="AccentPurple" Color="{StaticResource AccentPurpleColor}"/>

    <SolidColorBrush x:Key="ToggleOff" Color="{StaticResource ToggleOffColor}"/>
    <SolidColorBrush x:Key="ToggleOn" Color="{StaticResource ToggleOnColor}"/>

    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="Error" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}"/>

    <!-- CheckBox overrides for light theme -->
    <!-- Unchecked state -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedDisabled" Color="#f5f2eb"/>

    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#d4d1ca"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#C4884A"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#C4884A"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" Color="#a8a59e"/>

    <!-- Checked state -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#C4884A"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#D4985A"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#B4783A"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="#a8a59e"/>

    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#C4884A"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#D4985A"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#B4783A"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" Color="#a8a59e"/>

    <!-- Checkmark glyph color -->
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundUnchecked" Color="Transparent"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundUncheckedPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundUncheckedPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundUncheckedDisabled" Color="Transparent"/>

    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#ffffff"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#ffffff"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#ffffff"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" Color="#718096"/>

    <!-- CheckBox foreground (label text) -->
    <SolidColorBrush x:Key="CheckBoxForeground" Color="#000000"/>
    <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#000000"/>
    <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#000000"/>
    <SolidColorBrush x:Key="CheckBoxForegroundDisabled" Color="#718096"/>

    <!-- Window border -->
    <Color x:Key="WindowBorderColor">#C0C0C0</Color>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{DynamicResource WindowBorderColor}"/>

</ResourceDictionary>
