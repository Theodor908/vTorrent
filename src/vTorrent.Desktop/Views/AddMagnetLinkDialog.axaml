<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:vTorrent.Desktop.ViewModels.Dialogs"
        mc:Ignorable="d"
        d:DesignWidth="500"
        d:DesignHeight="380"
        x:Class="vTorrent.Desktop.Views.AddMagnetLinkDialog"
        x:DataType="vm:AddMagnetLinkViewModel"
        Title="Add Magnet Link"
        Width="500"
        Height="380"
        MinWidth="400"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        SystemDecorations="None"
        CornerRadius="0"
        Background="{DynamicResource PrimaryBackground}">

    <Window.Styles>
        <!-- Section Header -->
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,16,0,10"/>
        </Style>

        <Style Selector="TextBlock.sectionHeaderFirst">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Label Text -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Value Text -->
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Input TextBox -->
        <Style Selector="TextBox.inputBox">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentGold}"/>
        </Style>

        <Style Selector="TextBox.inputBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <Style Selector="TextBox.inputBox /template/ Border">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        </Style>

        <Style Selector="TextBox.inputBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        </Style>

        <Style Selector="TextBox.inputBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGold}"/>
        </Style>

        <Style Selector="TextBox.inputBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGold}"/>
        </Style>

        <!-- Browse Button -->
        <Style Selector="Button.browseButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.browseButton:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGold}"/>
        </Style>

        <Style Selector="Button.browseButton:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGold}"/>
        </Style>

        <!-- CheckBox Style -->
        <Style Selector="CheckBox.option">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- Primary Button -->
        <Style Selector="Button.primaryButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.primaryButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.primaryButton:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.primaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.primaryButton:pointerover /template/ Border">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
        </Style>

        <Style Selector="Button.primaryButton:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.primaryButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.primaryButton:pressed /template/ Border">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
        </Style>

        <Style Selector="Button.primaryButton:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Secondary Button -->
        <Style Selector="Button.secondaryButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.secondaryButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.secondaryButton:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentSilver}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSilver}"/>
        </Style>

        <Style Selector="Button.secondaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.secondaryButton:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentSilver}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSilver}"/>
        </Style>

        <Style Selector="Button.secondaryButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Title Bar (Draggable) -->
        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryBackground}"
                Padding="16,10"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Label FontFamily="{DynamicResource Phosphor}"
                           FontSize="18"
                           Content="&#xE2E2;"
                           Foreground="{DynamicResource AccentGold}"
                           Margin="0,0,8,0"/>
                    <TextBlock Text="Add Magnet Link"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="dialogCloseButton"
                        Padding="6,4"
                        Command="{Binding CancelCommand}">
                    <Label FontFamily="{DynamicResource Phosphor}"
                           FontSize="14"
                           Content="&#xE4F6;"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" Margin="16,16,16,20">
            <StackPanel>
                <!-- Magnet Link Input -->
                <TextBlock Classes="sectionHeaderFirst" Text="MAGNET LINK"/>
                <TextBlock Classes="label" Text="Paste magnet URI below"/>
                <TextBox Classes="inputBox"
                         Text="{Binding MagnetUri, Mode=TwoWay}"
                         Watermark="magnet:?xt=urn:btih:..."
                         AcceptsReturn="False"
                         TextWrapping="Wrap"
                         Height="60"
                         Name="MagnetUriTextBox"/>

                <!-- Parsed Info (shown when valid) -->
                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="0"
                        Padding="12"
                        Margin="0,12,0,0"
                        IsVisible="{Binding IsParsedSuccessfully}">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="80,*">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Name:"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="value"
                                   Text="{Binding TorrentName}"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Hash:" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="value"
                                   Text="{Binding InfoHash}"
                                   FontFamily="Consolas, Courier New"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,6,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Trackers:" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="value"
                                   Text="{Binding TrackerCount}"
                                   Margin="0,6,0,0"/>
                    </Grid>
                </Border>

                <!-- Save Location -->
                <TextBlock Classes="sectionHeader" Text="SAVE LOCATION"/>
                <TextBlock Classes="label" Text="Save at"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Classes="inputBox"
                             Text="{Binding SavePath, Mode=TwoWay}"
                             Watermark="Select download folder..."
                             IsReadOnly="True"/>
                    <Button Grid.Column="1"
                            Classes="browseButton"
                            Margin="8,0,0,0"
                            Command="{Binding BrowseFolderCommand}">
                        <Label FontFamily="{DynamicResource Phosphor}"
                               FontSize="14"
                               Content="&#xE236;"/>
                    </Button>
                </Grid>

                <!-- Options -->
                <CheckBox Classes="option"
                          IsChecked="{Binding StartTorrent}"
                          Content="Start downloading when metadata is received"/>
                <CheckBox Classes="option"
                          IsChecked="{Binding SequentialDownload}"
                          Content="Download in sequential order"/>
            </StackPanel>
        </ScrollViewer>

        <!-- File Tree Panel (visible after metadata received) -->
        <Grid Grid.Row="1"
              IsVisible="{Binding IsMetadataPhase}"
              RowDefinitions="Auto,Auto,*,Auto"
              Margin="16,8,16,0">
            <!-- Header with Select All/None + Search -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8">
                <Button Grid.Column="0" Classes="primaryButton"
                        Content="Select All"
                        Command="{Binding SelectAllFilesCommand}"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="1" Classes="secondaryButton"
                        Content="Select None"
                        Command="{Binding SelectNoFilesCommand}"/>
                <TextBox Grid.Column="3"
                         Classes="inputBox"
                         Width="180"
                         Watermark="Filter files..."
                         Text="{Binding FileSearchText, Mode=TwoWay}"/>
            </Grid>

            <!-- Torrent Name -->
            <TextBlock Grid.Row="1"
                       Text="{Binding TorrentName}"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimary}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,6"/>

            <!-- File Tree -->
            <TreeView Grid.Row="2"
                      ItemsSource="{Binding FileTree.Children}"
                      Background="{DynamicResource SecondaryBackground}"
                      BorderBrush="{DynamicResource BorderColor}"
                      BorderThickness="1">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              IsVisible="{Binding IsVisible}">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Size}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="12,0"
                                       IsVisible="{Binding !IsFolder}"/>
                        </Grid>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- Selected Size Footer -->
            <TextBlock Grid.Row="3"
                       Text="{Binding SelectedSizeText}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,6,0,0"/>
        </Grid>

        <!-- Bottom Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource PrimaryBackground}"
                Padding="16,10">
            <Grid>
                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#EF4444"
                           FontSize="12"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasError}"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Classes="secondaryButton"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"/>
                    <Button Classes="primaryButton"
                            Content="Add Magnet Link"
                            Command="{Binding AcceptCommand}"
                            IsEnabled="{Binding CanAccept}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3"
                Background="#80000000"
                IsVisible="{Binding IsLoading}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"/>
                <TextBlock Text="Adding magnet link..."
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
