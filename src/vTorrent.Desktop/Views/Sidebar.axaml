<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:vTorrent.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="280"
             d:DesignHeight="700"
             x:Class="vTorrent.Desktop.Views.Sidebar"
             x:DataType="vm:SidebarViewModel">

    <UserControl.Styles>
        <!-- Sidebar Container -->
        <Style Selector="Border.sidebarContainer">
            <Setter Property="Background" Value="{DynamicResource PrimaryBackground}"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Padding" Value="16,8,16,16"/>
        </Style>

        <!-- Section Header -->
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="12,24,0,12"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>

        <!-- Menu Item Button -->
        <Style Selector="Button.sidebarMenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style Selector="Button.sidebarMenuItem:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.sidebarMenuItem:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style Selector="Button.sidebarMenuItem.selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.sidebarMenuItem.selected /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- Menu Item Icon hover/pressed states -->
        <Style Selector="Button.sidebarMenuItem:pointerover Label.menuIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
        </Style>

        <Style Selector="Button.sidebarMenuItem:pressed Label.menuIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
        </Style>

        <Style Selector="Button.sidebarMenuItem.selected Label.menuIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
        </Style>

        <!-- Menu Item Icon -->
        <Style Selector="Label.menuIcon">
            <Setter Property="FontFamily" Value="{DynamicResource Phosphor}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,-4,12,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Settings Toggle Icon (default: TextPrimary, active: AccentGold) -->
        <Style Selector="Label.settingsToggleIcon">
            <Setter Property="FontFamily" Value="{DynamicResource Phosphor}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,-4,12,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style Selector="Label.settingsToggleIcon.active">
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
        </Style>

        <!-- DHT Status Icon (default: TextSecondary, active: AccentGold, initializing: pulsing) -->
        <Style Selector="Label.dhtStatusIcon">
            <Setter Property="FontFamily" Value="{DynamicResource Phosphor}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style Selector="Label.dhtStatusIcon.active">
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Label.dhtStatusIcon.initializing">
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Icon Menu Item Text -->
        <Style Selector="TextBlock.iconMenuText">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- Menu Item Text -->
        <Style Selector="TextBlock.menuText">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- Count (simple number, no badge) -->
        <Style Selector="Border.countBadge">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style Selector="Border.countBadge TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Expand Arrow -->
        <Style Selector="Label.expandArrow">
            <Setter Property="FontFamily" Value="{DynamicResource Phosphor}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,-1,4,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Action Button (icon only) -->
        <Style Selector="Button.actionButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.actionButton:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
        </Style>

        <Style Selector="Button.actionButton:pointerover Label">
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
        </Style>

        <Style Selector="Button.actionButton:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
        </Style>

        <Style Selector="Button.actionButton:pressed Label">
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
        </Style>

        <!-- Expandable Search Container -->
        <Style Selector="Border.expandableSearch">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.expandableSearch.expanded">
            <Setter Property="Width" Value="200"/>
        </Style>

        <Style Selector="Border.expandableSearch:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGold}"/>
        </Style>

        <!-- Search TextBox -->
        <Style Selector="TextBox.searchInput">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Watermark" Value="Search..."/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentCyan}"/>
        </Style>

        <!-- Search TextBox inner template background -->
        <Style Selector="TextBox.searchInput /template/ Border">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="TextBox.searchInput /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="TextBox.searchInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="TextBox.searchInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="TextBox.searchInput:focus /template/ Border">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Panel Input TextBox -->
        <Style Selector="TextBox.panelInput">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentCyan}"/>
        </Style>

        <Style Selector="TextBox.panelInput:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGold}"/>
        </Style>

        <Style Selector="TextBox.panelInput /template/ Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryBackground}"/>
        </Style>

        <Style Selector="TextBox.panelInput:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackground}"/>
        </Style>

        <Style Selector="TextBox.panelInput:focus /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackground}"/>
        </Style>

        <!-- Tag Color Dot -->
        <Style Selector="Ellipse.tagDot">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Tag Checkmark Icon (uses Phosphor) -->
        <Style Selector="Label.tagCheckmark">
            <Setter Property="FontFamily" Value="{DynamicResource Phosphor}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Category Selection Icon (uses regular Phosphor) -->
        <Style Selector="Label.categoryIcon">
            <Setter Property="FontFamily" Value="{DynamicResource Phosphor}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- More Button -->
        <Style Selector="Button.moreButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="12,2,0,0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style Selector="Button.moreButton:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
        </Style>

        <Style Selector="Button.moreButton:pressed">
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
        </Style>

        <Style Selector="Button.moreButton.selected">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGold}"/>
        </Style>

        <!-- More Icon - inherits Foreground from parent Button -->
        <Style Selector="Label.moreIcon">
            <Setter Property="FontFamily" Value="{DynamicResource Phosphor}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,-4,0,0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Side Panel (Overlay) -->
        <Style Selector="Border.sidePanel">
            <Setter Property="Background" Value="{DynamicResource PrimaryBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="ZIndex" Value="100"/>
        </Style>

        <!-- Add Button in Panel -->
        <Style Selector="Button.addButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style Selector="Button.addButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.addButton:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.addButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.addButton:pointerover /template/ Border">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
        </Style>

        <Style Selector="Button.addButton:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.addButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.addButton:pressed /template/ Border">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
        </Style>

        <!-- Toggle Switch Styling -->
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="40"/>
        </Style>

        <!-- Settings Item Container -->
        <Style Selector="Border.settingsItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style Selector="Border.settingsItem:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Minimal Toggle Switch for Settings -->
        <Style Selector="Border.settingsItem ToggleSwitch">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Toggle track (off state) - target all possible borders -->
        <Style Selector="Border.settingsItem ToggleSwitch /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToggleOff}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Border.settingsItem ToggleSwitch /template/ Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ToggleOff}"/>
        </Style>

        <!-- Toggle knob (off state) - target ellipse in multiple ways -->
        <Style Selector="Border.settingsItem ToggleSwitch /template/ Ellipse#SwitchKnobOn">
            <Setter Property="Fill" Value="{DynamicResource ToggleOff}"/>
        </Style>

        <Style Selector="Border.settingsItem ToggleSwitch /template/ Ellipse#SwitchKnobOff">
            <Setter Property="Fill" Value="{DynamicResource ToggleOff}"/>
        </Style>

        <Style Selector="Border.settingsItem ToggleSwitch /template/ Ellipse">
            <Setter Property="Fill" Value="{DynamicResource ToggleOff}"/>
        </Style>

        <!-- Toggle track (on state) -->
        <Style Selector="Border.settingsItem ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToggleOn}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Border.settingsItem ToggleSwitch:checked /template/ Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ToggleOn}"/>
        </Style>

        <!-- Toggle knob (on state) -->
        <Style Selector="Border.settingsItem ToggleSwitch:checked /template/ Ellipse#SwitchKnobOn">
            <Setter Property="Fill" Value="{DynamicResource ToggleOn}"/>
        </Style>

        <Style Selector="Border.settingsItem ToggleSwitch:checked /template/ Ellipse#SwitchKnobOff">
            <Setter Property="Fill" Value="{DynamicResource ToggleOn}"/>
        </Style>

        <Style Selector="Border.settingsItem ToggleSwitch:checked /template/ Ellipse">
            <Setter Property="Fill" Value="{DynamicResource ToggleOn}"/>
        </Style>
    </UserControl.Styles>

    <!-- Use Panel to allow overlaying side panels on top of main content -->
    <Panel>
        <!-- Main Sidebar Content -->
        <Border Classes="sidebarContainer">
            <Grid RowDefinitions="Auto,*,Auto">
            <!-- Fixed Action Buttons at Top -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <!-- Action Buttons (visible when search collapsed) -->
                <StackPanel Orientation="Horizontal"
                            IsVisible="{Binding !IsSearchExpanded, FallbackValue=True}">
                    <!-- Search Button (first in line) -->
                    <Button Classes="actionButton"
                            Command="{Binding ToggleSearchCommand}"
                            ToolTip.Tip="Search torrents">
                        <Label FontFamily="{DynamicResource Phosphor}"
                               FontSize="20"
                               Content="&#xE30C;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Button>

                    <!-- Add from File Button -->
                    <Button Classes="actionButton"
                            Command="{Binding AddFromFileCommand}"
                            ToolTip.Tip="Add torrent from file"
                            Margin="8,0,0,0">
                        <Label FontFamily="{DynamicResource Phosphor}"
                               FontSize="20"
                               Content="&#xE236;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Button>

                    <!-- Add from Magnet Button -->
                    <Button Classes="actionButton"
                            Command="{Binding AddFromMagnetCommand}"
                            ToolTip.Tip="Add magnet link"
                            Margin="8,0,0,0">
                        <Label FontFamily="{DynamicResource Phosphor}"
                               FontSize="20"
                               Content="&#xE2E2;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Button>

                    <!-- DHT Status Button -->
                    <Button Classes="actionButton"
                            Command="{Binding ToggleDhtCommand}"
                            ToolTip.Tip="{Binding DhtTooltip}"
                            Margin="8,0,0,0">
                        <Label Classes="dhtStatusIcon"
                               Classes.active="{Binding IsDhtRunning}"
                               Classes.initializing="{Binding IsDhtInitializing}"
                               Content="{Binding DhtIcon}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Button>

                    <!-- Tools Button -->
                    <Button Classes="actionButton"
                            Command="{Binding OpenToolsWindowCommand}"
                            ToolTip.Tip="Tools (Creator / Editor)"
                            Margin="8,0,0,0">
                        <Label FontFamily="{DynamicResource Phosphor}"
                               FontSize="20"
                               Content="&#xECA0;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Expanded Search Bar (overlays entire top area) -->
                <Border IsVisible="{Binding IsSearchExpanded, FallbackValue=False}"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="40"
                        HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Search Icon -->
                        <Button Grid.Column="0"
                                Classes="iconOnlyButton"
                                Command="{Binding ToggleSearchCommand}"
                                Width="40"
                                Height="40"
                                ToolTip.Tip="Close search">
                            <Label FontFamily="{DynamicResource Phosphor}"
                                   FontSize="18"
                                   Content="&#xE30C;"
                                   Foreground="{DynamicResource AccentGold}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Button>

                        <!-- Search Input -->
                        <TextBox Grid.Column="1"
                                 Classes="searchInput"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 Watermark="Search torrents..."
                                 VerticalAlignment="Center"/>

                        <!-- Clear Button -->
                        <Button Grid.Column="2"
                                Classes="iconOnlyButton"
                                Command="{Binding ClearSearchCommand}"
                                Width="36"
                                Height="36"
                                Margin="0,0,4,0"
                                IsVisible="{Binding SearchText.Length}"
                                ToolTip.Tip="Clear search">
                            <Label FontFamily="{DynamicResource Phosphor}"
                                   FontSize="16"
                                   Content="&#xE4F6;"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Separator Line -->
            <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderColor}"
                    VerticalAlignment="Top" Margin="0,0,0,0"/>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,9,0,0">
                <StackPanel>
                    <!-- OVERVIEW Section -->
                    <TextBlock Classes="sectionHeader" Text="OVERVIEW"/>

                <ItemsControl ItemsSource="{Binding OverviewItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SidebarMenuItemViewModel">
                            <Button Classes="sidebarMenuItem"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SelectItemCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Label Grid.Column="0"
                                           Classes="menuIcon"
                                           Content="{Binding Icon}"/>
                                    <TextBlock Grid.Column="1"
                                               Classes="iconMenuText"
                                               Text="{Binding Name}"/>
                                    <Border Grid.Column="2"
                                            Classes="countBadge"
                                            IsVisible="{Binding HasCount}">
                                        <TextBlock Text="{Binding Count}"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- CATEGORIES Section -->
                <TextBlock Classes="sectionHeader" Text="CATEGORIES"/>

                <ItemsControl ItemsSource="{Binding CategoriesItems}" Margin="12,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SidebarMenuItemViewModel">
                            <Button Classes="sidebarMenuItem"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SelectItemCommand}"
                                    CommandParameter="{Binding}"
                                    DoubleTapped="OnCategoryDoubleTapped"
                                    Tag="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Folder icon (visible when selected) -->
                                    <Label Classes="categoryIcon"
                                           Content="&#xE256;"
                                           IsVisible="{Binding IsSelected}"/>
                                    <TextBlock Classes="menuText"
                                               Text="{Binding Name}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- More Categories Button with Popup -->
                <Button x:Name="CategoriesMoreButton"
                        Classes="moreButton"
                        Classes.selected="{Binding IsCategoriesPanelOpen}"
                        Command="{Binding ToggleCategoriesPanelCommand}">
                    <Label Classes="moreIcon"
                           Content="&#xE1FE;"
                           Foreground="{Binding $parent[Button].Foreground}"/>
                </Button>


                <!-- TAGS Section -->
                <TextBlock Classes="sectionHeader" Text="TAGS"/>

                <ItemsControl ItemsSource="{Binding TagsItems}" Margin="12,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SidebarMenuItemViewModel">
                            <Button Classes="sidebarMenuItem"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SelectItemCommand}"
                                    CommandParameter="{Binding}"
                                    DoubleTapped="OnTagDoubleTapped"
                                    Tag="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Checkmark (visible when selected) -->
                                    <Label Classes="tagCheckmark"
                                           Content="&#xE190;"
                                           IsVisible="{Binding IsSelected}"/>
                                    <TextBlock Classes="menuText"
                                               Text="{Binding Name}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- More Tags Button with Popup -->
                <Button x:Name="TagsMoreButton"
                        Classes="moreButton"
                        Classes.selected="{Binding IsTagsPanelOpen}"
                        Command="{Binding ToggleTagsPanelCommand}">
                    <Label Classes="moreIcon"
                           Content="&#xE1FE;"
                           Foreground="{Binding $parent[Button].Foreground}"/>
                </Button>


                </StackPanel>
            </ScrollViewer>

            <!-- Fixed SETTINGS Section at Bottom -->
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,8"/>

                <!-- Settings Button -->
                <ItemsControl ItemsSource="{Binding SettingsItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SidebarMenuItemViewModel">
                            <Button Classes="sidebarMenuItem"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SelectItemCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0"
                                           Classes="menuIcon"
                                           Margin="0,0,12,0"
                                           Content="{Binding Icon}"/>
                                    <TextBlock Grid.Column="1"
                                               FontSize="14"
                                               Margin="0,-2,0,0"
                                               Text="{Binding Name}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Notifications Toggle -->
                <Border Classes="settingsItem">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Classes="settingsToggleIcon"
                               Classes.active="{Binding NotificationsEnabled}"
                               Content="{Binding NotificationIcon}"/>
                        <TextBlock Grid.Column="1"
                                   Classes="iconMenuText"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="Notifications"/>
                        <ToggleSwitch Grid.Column="2"
                                      IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Theme Toggle -->
                <Border Classes="settingsItem">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Classes="settingsToggleIcon"
                               Foreground="{DynamicResource AccentGold}"
                               Content="{Binding ThemeIcon}"/>
                        <TextBlock Grid.Column="1"
                                   Classes="iconMenuText"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Text="{Binding ThemeLabel}"/>
                        <ToggleSwitch Grid.Column="2"
                                      IsChecked="{Binding DarkThemeEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
        </Border>

        <!-- Categories Side Panel (Overlay) -->
        <Border Classes="sidePanel"
                IsVisible="{Binding IsCategoriesPanelOpen, FallbackValue=False}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Panel Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                    <Button Grid.Column="0"
                            Classes="iconOnlyButton"
                            Command="{Binding CloseCategoriesPanelCommand}"
                            Width="32"
                            Height="32"
                            Padding="0">
                        <Label FontFamily="{DynamicResource Phosphor}"
                               FontSize="20"
                               Content="&#xE058;"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Padding="0"
                               Margin="0"/>
                    </Button>
                    <TextBlock Grid.Column="1"
                               Text="Categories"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>

                <!-- Scrollable Categories List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AllCategoriesItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarMenuItemViewModel">
                                <Button Classes="sidebarMenuItem"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SelectItemCommand}"
                                        CommandParameter="{Binding}"
                                        DoubleTapped="OnCategoryDoubleTapped"
                                        Tag="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Folder icon (visible when selected) -->
                                        <Label Grid.Column="0"
                                               Classes="categoryIcon"
                                               Content="&#xE256;"
                                               IsVisible="{Binding IsSelected}"/>
                                        <TextBlock Grid.Column="1"
                                                   Classes="menuText"
                                                   Text="{Binding Name}"/>
                                        <!-- Edit icon -->
                                        <Button Grid.Column="2"
                                                Classes="iconOnlyButton"
                                                Click="OnCategoryEditClick"
                                                Tag="{Binding}"
                                                IsVisible="{Binding HasDatabaseId}"
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                VerticalAlignment="Center">
                                            <Label FontFamily="{DynamicResource Phosphor}"
                                                   FontSize="12"
                                                   Content="&#xE3AE;"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="0"
                                                   Margin="0"/>
                                        </Button>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Create New Category -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button Classes="addButton"
                            Command="{Binding CreateCategoryCommand}">
                        <TextBlock Text="Create" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tags Side Panel (Overlay) -->
        <Border Classes="sidePanel"
                IsVisible="{Binding IsTagsPanelOpen, FallbackValue=False}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Panel Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                    <Button Grid.Column="0"
                            Classes="iconOnlyButton"
                            Command="{Binding CloseTagsPanelCommand}"
                            Width="32"
                            Height="32"
                            Padding="0">
                        <Label FontFamily="{DynamicResource Phosphor}"
                               FontSize="20"
                               Content="&#xE058;"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Padding="0"
                               Margin="0"/>
                    </Button>
                    <TextBlock Grid.Column="1"
                               Text="Tags"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>

                <!-- Scrollable Tags List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AllTagsItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarMenuItemViewModel">
                                <Button Classes="sidebarMenuItem"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding $parent[UserControl].((vm:SidebarViewModel)DataContext).SelectItemCommand}"
                                        CommandParameter="{Binding}"
                                        DoubleTapped="OnTagDoubleTapped"
                                        Tag="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Checkmark (visible when selected) -->
                                        <Label Grid.Column="0"
                                               Classes="tagCheckmark"
                                               Content="&#xE190;"
                                               IsVisible="{Binding IsSelected}"/>
                                        <TextBlock Grid.Column="1"
                                                   Classes="menuText"
                                                   Text="{Binding Name}"/>
                                        <!-- Edit icon -->
                                        <Button Grid.Column="2"
                                                Classes="iconOnlyButton"
                                                Click="OnTagEditClick"
                                                Tag="{Binding}"
                                                IsVisible="{Binding HasDatabaseId}"
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                VerticalAlignment="Center">
                                            <Label FontFamily="{DynamicResource Phosphor}"
                                                   FontSize="12"
                                                   Content="&#xE3AE;"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="0"
                                                   Margin="0"/>
                                        </Button>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Create New Tag -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button Classes="addButton"
                            Command="{Binding CreateTagCommand}">
                        <TextBlock Text="Create" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Panel>
</UserControl>
