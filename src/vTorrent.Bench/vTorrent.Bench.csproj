    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>vTorrent.Bench</RootNamespace>
    <AssemblyName>vtorrent-bench</AssemblyName>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\vTorrent.Core\vTorrent.Core.csproj" />
    <ProjectReference Include="..\vTorrent.Abstractions\vTorrent.Abstractions.csproj" />
