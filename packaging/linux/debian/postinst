#!/bin/bash
# vTorrent post-installation script
# This script is executed after the package is installed

set -e

case "$1" in
    configure)
        # Update desktop database to register the .desktop file
        if command -v update-desktop-database >/dev/null 2>&1; then
            echo "Updating desktop database..."
            update-desktop-database -q /usr/share/applications 2>/dev/null || true
        fi

        # Update MIME database to register file associations
        if command -v update-mime-database >/dev/null 2>&1; then
            echo "Updating MIME database..."
            update-mime-database /usr/share/mime 2>/dev/null || true
        fi

        # Update icon cache for better performance
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            echo "Updating icon cache..."
            for theme_dir in /usr/share/icons/hicolor; do
                if [ -d "$theme_dir" ]; then
                    gtk-update-icon-cache -f -t "$theme_dir" 2>/dev/null || true
                fi
            done
        fi

        # Register magnet link protocol handler with xdg-mime
        if command -v xdg-mime >/dev/null 2>&1; then
            echo "Registering magnet link handler..."
            xdg-mime default vTorrent.desktop x-scheme-handler/magnet 2>/dev/null || true
        fi

        # Register .torrent file association
        if command -v xdg-mime >/dev/null 2>&1; then
            echo "Registering .torrent file association..."
            xdg-mime default vTorrent.desktop application/x-bittorrent 2>/dev/null || true
        fi

        # Update shared MIME info database
        if [ -x /usr/bin/update-mime-database ]; then
            update-mime-database /usr/share/mime 2>/dev/null || true
        fi

        # Validate and install the desktop file
        if command -v desktop-file-validate >/dev/null 2>&1; then
            desktop-file-validate /usr/share/applications/vTorrent.desktop 2>/dev/null || true
        fi

        # Update AppStream metadata cache
        if command -v appstreamcli >/dev/null 2>&1; then
            echo "Refreshing AppStream cache..."
            appstreamcli refresh-cache 2>/dev/null || true
        fi

        echo "vTorrent has been installed successfully."
        echo "You can launch it from your application menu or by running 'vTorrent' in terminal."
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
