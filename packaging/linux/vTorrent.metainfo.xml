      <caption>Main window showing torrent list</caption>
      <image type="source" width="1280" height="720">https://vtorrent.example.com/screenshots/main-window.png</image>
    </screenshot>
    <screenshot>
      <caption>Torrent details and peer information</caption>
      <image type="source" width="1280" height="720">https://vtorrent.example.com/screenshots/torrent-details.png</image>
    </screenshot>
    <screenshot>
      <caption>Settings and preferences</caption>
      <image type="source" width="1280" height="720">https://vtorrent.example.com/screenshots/settings.png</image>
    </screenshot>
    <screenshot>
      <caption>Dark theme</caption>
      <image type="source" width="1280" height="720">https://vtorrent.example.com/screenshots/dark-theme.png</image>
