  <url type="homepage">https://vtorrent.example.com</url>
  <url type="bugtracker">https://github.com/vtorrent/vtorrent/issues</url>
  <url type="help">https://vtorrent.example.com/docs</url>
  <url type="donation">https://vtorrent.example.com/donate</url>

  <developer_name>vTorrent Developers</developer_name>

  <provides>
    <binary>vTorrent</binary>
    <mediatype>application/x-bittorrent</mediatype>
    <mediatype>x-scheme-handler/magnet</mediatype>
  </provides>

  <mimetypes>
    <mimetype>application/x-bittorrent</mimetype>
    <mimetype>x-scheme-handler/magnet</mimetype>
  </mimetypes>

  <categories>
    <category>Network</category>
    <category>FileTransfer</category>
    <category>P2P</category>
  </categories>

  <keywords>
    <keyword>torrent</keyword>
    <keyword>bittorrent</keyword>
    <keyword>download</keyword>
    <keyword>p2p</keyword>
    <keyword>magnet</keyword>
    <keyword>file sharing</keyword>
  </keywords>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.0.0" date="2024-01-01">
      <description>
        <p>Initial release of vTorrent with the following features:</p>
        <ul>
          <li>Full BitTorrent protocol support</li>
          <li>DHT and peer exchange</li>
          <li>Magnet link handling</li>
          <li>Modern Avalonia-based UI</li>
          <li>Light and dark themes</li>
          <li>Cross-platform support (Windows, Linux, macOS)</li>
        </ul>
      </description>
    </release>
  </releases>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <recommends>
    <memory>512</memory>
    <internet>always</internet>
  </recommends>
</component>
