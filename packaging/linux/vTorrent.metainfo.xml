<component type="desktop-application">
  <id>com.vtorrent.vTorrent</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>

  <name>vTorrent</name>
  <summary>A modern BitTorrent client</summary>

  <description>
    <p>
      vTorrent is a modern, cross-platform BitTorrent client built with performance
      and usability in mind. It features a clean, intuitive interface while providing
      powerful functionality for managing your torrents.
    </p>
    <p>Key features include:</p>
    <ul>
      <li>Modern, responsive user interface with light and dark themes</li>
      <li>DHT (Distributed Hash Table) support for trackerless torrents</li>
      <li>Magnet link support for easy torrent sharing</li>
      <li>Intelligent bandwidth management and scheduling</li>
      <li>Sequential downloading option for media files</li>
      <li>Peer exchange (PEX) for improved peer discovery</li>
      <li>uTP (Micro Transport Protocol) support for network-friendly transfers</li>
      <li>IP filtering and encryption support</li>
    </ul>
  </description>

  <launchable type="desktop-id">vTorrent.desktop</launchable>

  <screenshots>
