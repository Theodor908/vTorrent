<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Project Configuration -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- MSIX Packaging Configuration -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Package Identity -->
    <AppxPackage>true</AppxPackage>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageDir>$(MSBuildProjectDirectory)\AppPackages\</AppxPackageDir>
    <AppxPackageName>vTorrent</AppxPackageName>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>true</AppxSymbolPackageEnabled>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>

    <!-- Manifest Configuration -->
    <AppxManifest>Package.appxmanifest</AppxManifest>

    <!-- Signing Configuration (Development) -->
    <!-- For development, use a self-signed certificate -->
    <!-- Generate one using: New-SelfSignedCertificate -Type Custom -Subject "CN=vTorrent" -KeyUsage DigitalSignature -FriendlyName "vTorrent Dev Certificate" -CertStoreLocation "Cert:\CurrentUser\My" -TextExtension @("2.5.29.37={text}1.3.6.1.5.5.7.3.3", "2.5.29.19={text}") -->
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint></PackageCertificateThumbprint>
    <!-- Alternatively, use a .pfx file -->
    <!-- <PackageCertificateKeyFile>vTorrent_DevCert.pfx</PackageCertificateKeyFile> -->

    <!-- For unsigned packages during development, set to false -->
    <!-- <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled> -->

    <!-- Platform Configuration -->
    <Platforms>x64;arm64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>

    <!-- Version Information -->
    <ApplicationVersion>1.0.0.0</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
  </PropertyGroup>

  <!-- Debug Configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <!-- Allow unsigned packages in debug -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>

  <!-- Release Configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
  </PropertyGroup>

  <!-- x64 Platform Configuration -->
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- ARM64 Platform Configuration -->
  <PropertyGroup Condition="'$(Platform)' == 'arm64'">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Reference to the main vTorrent project -->
  <ItemGroup>
    <ProjectReference Include="..\..\vTorrent.csproj" />
  </ItemGroup>

  <!-- MSIX Assets -->
  <ItemGroup>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Package.appxmanifest">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- MSIX Mapping File Generation -->
  <ItemGroup>
    <None Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <!-- Required NuGet Packages for MSIX -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <!--
    Build Instructions:

    1. Generate a self-signed certificate for development:
       PowerShell (Run as Administrator):
       New-SelfSignedCertificate -Type Custom -Subject "CN=vTorrent" -KeyUsage DigitalSignature -FriendlyName "vTorrent Dev Certificate" -CertStoreLocation "Cert:\CurrentUser\My" -TextExtension @("2.5.29.37={text}1.3.6.1.5.5.7.3.3", "2.5.29.19={text}")

    2. Export the certificate thumbprint and update PackageCertificateThumbprint above

    3. Build the MSIX package:
       dotnet build -c Release -p:Platform=x64

    4. The MSIX package will be output to: AppPackages\

    For Store submission:
    - Use a trusted certificate from a Certificate Authority
    - Or use the Windows App Certification Kit to generate a signing certificate
  -->

</Project>
